# Production settings for Namecheap shared hosting. On the server, copy this file to `.env`
# (in the backend folder, NOT inside public_html) and fill in every value marked CHANGE ME.
# Full steps: DEPLOY.md at the repository root.

APP_NAME=Ennavizion
APP_ENV=production
# Generated on the server with `php artisan key:generate` — leave blank here.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ennavizion.com

# The public website. Used for CORS and as the page Paystack returns donors to.
FRONTEND_URL=https://ennavizion.com
CORS_EXTRA_ORIGINS=https://www.ennavizion.com

# Inbox that gets a "new submission" email (reference number only, no personal details).
# Blank = admin panel only.
NOTIFY_EMAIL=info@ennavizion.com

# Paystack LIVE keys (dashboard → Settings → API Keys & Webhooks). Use test keys first.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_MODE: off | test | live. Checkout opens only when the mode and key agree
# (test + sk_test_..., live + sk_live_...). A key on its own never opens checkout, and
# live mode must be set deliberately once the academy has authorised real payments.
PAYSTACK_MODE=off
# Test with an sk_test_ key first; switch to sk_live_ and PAYSTACK_MODE=live only when authorised.
# In the Paystack dashboard set the webhook URL to https://api.ennavizion.com/api/donations/webhook

# Days to keep form submissions before app:prune-submissions deletes them (needs the cron
# job in DEPLOY.md). Blank = keep until deleted by hand. The academy decides this.
SUBMISSION_RETENTION_DAYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases. cPanel prefixes names with your cPanel username,
# e.g. database "abcduser_ennavizion" and user "abcduser_env".
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_cpaneluser_ennavizion
DB_USERNAME=CHANGE_ME_cpaneluser_env
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Shared hosting has no long-running queue worker, so anything queued runs immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# cPanel → Email Accounts: create e.g. noreply@ennavizion.com, then use its password here.
# "Connect Devices" on that account shows the exact mail server name (usually mail.<domain>).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.ennavizion.com
MAIL_PORT=465
MAIL_USERNAME=noreply@ennavizion.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@ennavizion.com"
MAIL_FROM_NAME="${APP_NAME}"
